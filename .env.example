# Variables por entorno (react-native-config). Copiar a .env (ignorado por git). Sin secretos: todo lo de aquí
# termina dentro del APK. En CI, .env lo escribe el workflow con el secret API_URL.
# API de Leap: emulador Android -> http://10.0.2.2:8080/api · iOS simulador -> http://localhost:8080/api
API_URL=http://10.0.2.2:8080/api
# Entorno lógico: dev | staging | prod
APP_ENV=dev
