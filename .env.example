# Variables por entorno (react-native-config). Copiar a .env (ignorado por git). Sin secretos: todo lo de aquí
# termina dentro del APK. En CI, .env lo escribe el workflow con el secret API_URL.
# API de Leap: emulador Android -> http://10.0.2.2:8080/api · iOS simulador -> http://localhost:8080/api
API_URL=http://10.0.2.2:8080/api
# Teléfono físico por USB: crear .env.dispositivo con API_URL=http://localhost:8080/api, ejecutar
# adb reverse tcp:8080 tcp:8080 y compilar con ENVFILE=.env.dispositivo (README, «Probar en un teléfono por USB»).
# Entorno lógico: dev | staging | prod
APP_ENV=dev
# Login con Google (F1-06): client ID WEB de Google Cloud (la audiencia que verifica Leap en GOOGLE_CLIENT_IDS).
# Vacío = el botón «Continuar con Google» no aparece. No es secreto. iOS necesita además su client ID.
GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
