{
  "name": "apl-inglesconsebas-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "calidad": "npm run typecheck && npm run lint && npm run format:check && jest --coverage",
    "build:android:debug": "node scripts/gradle.mjs assembleDebug",
    "prepare": "husky"
  },
  "dependencies": {
    "@react-native/new-app-screen": "0.88.1",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-config": "1.7.2",
    "react-native-safe-area-context": "^5.5.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.88.1",
    "@react-native/eslint-config": "0.88.1",
    "@react-native/jest-preset": "0.88.1",
    "@react-native/metro-config": "0.88.1",
    "@react-native/typescript-config": "0.88.1",
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "babel-plugin-module-resolver": "5.0.3",
    "eslint": "^8.19.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-boundaries": "7.4.2",
    "husky": "9.1.7",
    "jest": "^29.6.3",
    "lint-staged": "17.6.0",
    "prettier": "2.8.8",
    "react-test-renderer": "19.3.0",
    "test-renderer": "1.3.1",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  },
  "lint-staged": {
    "*.{js,ts,tsx}": [
      "prettier --write",
      "eslint --max-warnings=0"
    ],
    "*.json": [
      "prettier --write"
    ]
  }
}
